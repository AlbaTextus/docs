{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "temp/typecheck.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true
  },
  "include": [
    ".cloudflare/types/**/*.d.ts",
    "vite.config.ts",
    "cloudflare.config.ts",
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "components/**/*.ts",
    "lib/**/*.ts",
    "temp/next/types/**/*.ts",
    "temp/next/dev/types/**/*.ts",
    "release/next/types/**/*.ts",
    "release/next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
